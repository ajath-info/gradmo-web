  "item": [
    {
      "name": "Homework List",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"access_token\": \"{{access_token}}\",\n  \"batch_id\": {{batch_id}},\n  \"page\": 1,\n  \"limit\": 20\n}"
        },
        "url": "{{base_url}}/api/batch/homework-list"
      }
    },
    {
      "name": "Homework Details",
      "request": {
